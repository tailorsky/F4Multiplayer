diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
new file mode 100644
index 0000000..6287c76
--- /dev/null
+++ b/.github/workflows/build.yml
@@ -0,0 +1,44 @@
+# Builds the plugin, the server, the bot and the unit tests on a Windows runner (MSVC), runs the tests, and keeps
+# F4Multiplayer.dll (with its .pdb) as the run's artifact: Actions > Build > Run workflow, then download "F4Multiplayer"
+# from the finished run's page.
+name: Build
+
+on:
+  workflow_dispatch:
+  push:
+
+permissions:
+  contents: read
+
+jobs:
+  build:
+    runs-on: windows-latest
+    steps:
+      - name: Check out (with CommonLibF4)
+        uses: actions/checkout@v4
+        with:
+          submodules: recursive
+
+      - name: Set up xmake
+        uses: xmake-io/github-action-setup-xmake@v1
+        with:
+          xmake-version: latest
+
+      - name: Configure
+        run: xmake f -y -m releasedbg
+
+      - name: Build
+        run: xmake build -y
+
+      - name: Run the unit tests
+        timeout-minutes: 15  # a server test that deadlocks would otherwise hang the run
+        run: build\windows\x64\releasedbg\F4MPTests.exe
+
+      - name: Keep the plugin
+        uses: actions/upload-artifact@v4
+        with:
+          name: F4Multiplayer
+          path: |
+            build/windows/x64/releasedbg/F4Multiplayer.dll
+            build/windows/x64/releasedbg/F4Multiplayer.pdb
+          if-no-files-found: error
